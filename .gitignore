# ── Editor and OS cruft ──────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# macOS metadata pollution, which is especially noisy on NFS mounts
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes

# ── Environment files and secrets ────────────────────────────────
# The backend environment file at the repository root holds database
# credentials and the Space-Track login. Never commit it.
.env
.env.local
*.env.local

# The frontend has several environment files. The plain web/.env holds
# the Cesium ion token and must stay private. The .development and
# .production files hold only a public API URL and ARE committed, so
# they are deliberately not ignored here.
web/.env
web/.env.local
web/.env.*.local

# ── Python backend ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# The pixi environment directory is a local install, rebuilt from the
# lockfile, and must not be committed.
.pixi/

# ── Node frontend ────────────────────────────────────────────────
web/node_modules/
web/dist/
web/.vite/
npm-debug.log*

# ── Docker and runtime volumes ───────────────────────────────────
# Postgres and Prefect data directories, if any compose volume is
# bind-mounted into the tree.
pgdata/
prefect-data/

# ── C-SWIM data and outputs ──────────────────────────────────────
# The data directory holds the C-SWIM analysis outputs and the
# economic and rigidity files, tens of megabytes, regenerated by the
# pipeline rather than versioned.
data/

# ── Logs ─────────────────────────────────────────────────────────
*.log
logs/

# Postgres data volume, bind-mounted into the repo root by compose
.postgres-data/

# Prefect data volume, if bind-mounted
.prefect-data/